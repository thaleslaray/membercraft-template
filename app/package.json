{
  "name": "area-de-membros",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#e2e/*": "./e2e/*"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --secrets-file .prod.vars",
    "deploy:cloudflare": "wrangler d1 migrations apply escola --remote && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply escola --local",
    "db:migrate:remote": "wrangler d1 migrations apply escola --remote",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:migrate:teste:local": "wrangler d1 migrations apply escola-teste --env teste --local",
    "db:migrate:teste:remote": "wrangler d1 migrations apply escola-teste --env teste --remote",
    "deploy:teste": "npm run build:teste && wrangler deploy --env teste --secrets-file .teste.vars",
    "build:teste": "CLOUDFLARE_ENV=teste vite build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "@vimeo/player": "^2.30.4",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^4.2.1",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.3.6",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vite-plugin": "1.70.1",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-query-devtools": "5.108.4",
    "@tanstack/react-router-devtools": "1.167.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "4.167.0"
  }
}
